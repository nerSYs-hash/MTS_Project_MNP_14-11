{
  "name": "react-example",
  "private": true,
  "version": "2.9.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "VITE_HIDE_UNRELEASED=true vite build && node scripts/create_update_pkg.cjs 2.9.0",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "electron:start": "electron .",
    "dist:win": "VITE_HIDE_UNRELEASED=true vite build && electron-builder --win nsis",
    "dist:portable": "VITE_HIDE_UNRELEASED=true vite build && electron-builder --win portable",
    "dist:all": "VITE_HIDE_UNRELEASED=true vite build && electron-builder --win",
    "dist:urm": "VITE_HIDE_UNRELEASED=true vite build && electron-builder --win --dir -c.npmRebuild=false",
    "package:update": "VITE_HIDE_UNRELEASED=true vite build && node scripts/create_update_pkg.cjs 2.9.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
